{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Default permissions for the Vobes desktop app. Grants the frontend access to the core, event, window, and webview APIs plus the Tauri plugins we drive from JS. Custom commands in this crate are auto-allowed by the build system.",
	"windows": ["main", "*"],
	"permissions": [
		"core:default",
		"core:event:default",
		"core:window:default",
		"core:webview:default",
		"core:app:default",
		"core:path:default",

		"dialog:default",
		"dialog:allow-open",
		"dialog:allow-save",
		"dialog:allow-message",
		"dialog:allow-ask",
		"dialog:allow-confirm",

		"notification:default",
		"notification:allow-notify",
		"notification:allow-is-permission-granted",
		"notification:allow-request-permission",

		"opener:default",
		"opener:allow-open-path",
		"opener:allow-open-url",

		"updater:default",
		"process:allow-restart",
		"process:allow-exit",

		"deep-link:default"
	]
}
